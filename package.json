{
  "name": "avai-chat-widget",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "description": "Виджет чат-ассистента для сайта (Avangard AI)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build && vite build --config vite.core.config.ts && tsc -p tsconfig.core.json",
